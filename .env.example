# =============================================================================
# KOB — TEMPLATE ONLY (no real secrets). Copy to ".env.local" and fill in values:
#   cp .env.example .env.local
#
# Prisma CLI does not load .env.local by default. Use:
#   npm run db:migrate
# which loads .env then .env.local (later wins). Or put DATABASE_URL in a root ".env" file.
# =============================================================================

# --- Database (Prisma + Next) ---
# Supabase → Settings → Database → Connection string → use "Session pooler" URI on IPv4 networks.
# Append ssl if needed, e.g. ?sslmode=require  (follow Supabase’s Prisma snippet)
DATABASE_URL=

# --- Supabase (auth + client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hosted Auth redirects: npm run setup:auth-urls (paste output into Supabase Dashboard)
# NETLIFY_PRODUCTION_URL=https://your-site.netlify.app

# --- Supabase CLI (optional; does NOT replace Prisma for schema) ---
# Login (browser): npm run supabase:login  →  link project: npm run supabase:link  (use project ref from dashboard URL)
# Types from linked remote: npm run supabase:types  → writes lib/supabase/database.types.ts
# Headless / CI: Account → Access Tokens → paste here, plus project ref (subdomain before .supabase.co)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# Database password (dashboard). Used by: npm run supabase:sync-env → builds DATABASE_URL
# SUPABASE_DB_PASSWORD=

# --- Netlify CLI (optional) ---
# Login: npm run netlify:login  →  link site: netlify link  (from repo root)
# Deploy preview: npm run netlify:deploy
# CI (optional): NETLIFY_AUTH_TOKEN from Netlify user settings → Applications → Personal access tokens
# NETLIFY_AUTH_TOKEN=
# --- Production site (trykob.com) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://trykob.com
NETLIFY_PRODUCTION_URL=https://trykob.com

# --- Gemini (all AI: chat, briefs, content, images, audits) ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: image generation deployment (social posts with photos)
# GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation
# Creative Agent pack size (full / free preview)
# CREATIVE_PACK_SIZE=12
# CREATIVE_PACK_PREVIEW_SIZE=3
# Service request credits (monthly grant + costs)
# CREDITS_STARTER_MONTHLY=50
# CREDITS_PRO_MONTHLY=120
# CREDITS_COST_WEBSITE=40
# CREDITS_COST_LOGO=25
# CREDITS_COST_SEO=20
# CREDITS_COST_CREATIVE=10

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Used by Stripe.js / Payment Element in the browser when you add client-side payments.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Optional: defaults to STRIPE_PRICE_STARTER for `/api/trial` + API trial helpers.
STRIPE_GROWTH_PRICE_ID=
# Subscription trial length (days) on Checkout when set (1–90).
STRIPE_TRIAL_DAYS=
# Operator ticket queue (/ops/requests) — comma-separated emails allowed to pick up jobs.
# OPS_OPERATOR_EMAILS=you@trykob.com,ops@trykob.com

# --- Browserbase (visibility audit — JS-rendered sites) ---
# Optional paid SERP for Instagram discovery (not required — open-source ddgs works):
#   npm run outbound:ig-search-setup
# SERPER_API_KEY=
# https://browserbase.com — used when AUDIT_BROWSERBASE=1
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# 1 = force on; 0 = force off; unset = on when BROWSERBASE_* keys are set
# AUDIT_BROWSERBASE=1
# fallback | always (default when BROWSERBASE_* keys are set — recommended for Owner.com-grade scans)
# AUDIT_BROWSERBASE_MODE=always
# 1 = fetch scores first, then enrich via Inngest (recommended on short serverless timeouts)
AUDIT_BROWSERBASE_ASYNC=0
# 1 = use Browserbase managed proxies (may increase cost)
AUDIT_BROWSERBASE_PROXY=0

# --- Stagehand (optional LLM page extraction on Browserbase; costs tokens) ---
# Requires BROWSERBASE_* + an LLM key (GEMINI_API_KEY, ANTHROPIC_API_KEY, etc.).
# Owner.com crawl (free): npm run crawl:owner:free — paid render: npm run crawl:owner
# OWNER_CRAWL_MAX=30
AUDIT_STAGEHAND=0
# e.g. openai/gpt-4o-mini — see Stagehand model strings
AUDIT_STAGEHAND_MODEL=openai/gpt-4o-mini

# --- Audit screenshot heuristics (sharp stats on viewport PNG; set 0 to skip) ---
# AUDIT_VISUAL_METRICS=0

# --- Supabase Storage (optional public audit screenshots; service role bypasses RLS) ---
# Create bucket (e.g. kob-audit-screenshots) → public read or signed URLs per your policy.
# Login emails via Resend when Supabase SMTP fails (Dashboard → Settings → API → service_role)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_AUDIT_BUCKET=kob-audit-screenshots

# --- Sales pipeline — see docs/SALES_PIPELINE.md ---
# OUTBOUND_MODE=uk_cold                       # UK cold pipeline (recommended for growth)
# OUTBOUND_UK_CITIES=London,Manchester,Birmingham,Leeds,Bristol,Glasgow,Edinburgh
# OUTBOUND_REVIEW_MIN=20
# OUTBOUND_REVIEW_MAX=500
# OUTBOUND_MAX_QUALIFY_SCORE=65
# OUTBOUND_UK_DAILY_CAP=100
# HUNTER_API_KEY=                             # email enrichment (required for quality)
# APOLLO_API_KEY=                             # fallback after Hunter/scrape
# Independents only (no multi-site).
# LEAD_ENGINE_LOCATION_MAX=1
# Target 100 outbound emails/UTC day (hard cap 100).
# OUTBOUND_SEND_BATCH=100
# OUTBOUND_SEND_PER_RUN=100
# OUTBOUND_SEND_DELAY_SEC=1
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=KOB <hello@trykob.com>
# RESEND_REPLY_TO=hello@trykob.com
# RESEND_AUTH_FROM_EMAIL=KOB <hello@trykob.com>
# OUTBOUND_RESEND_NOTIFY_EMAIL=you@gmail.com
# Warm-up note: 100/day matches Resend free daily quota.
# OUTBOUND_SEND_BATCH=100
# OUTBOUND_SEND_DELAY_SEC=1
# OUTBOUND_WORKSPACE_RESTAURANT_ID=
# OUTBOUND_SCAN_CITY=London                   # legacy mode only
# OUTBOUND_SALES_MODE=1
# Comma-separated emails allowed to auto-join sales workspace when OUTBOUND_SALES_MODE=1 (required; fail closed).
# OUTBOUND_SALES_ALLOWLIST=you@trykob.com,ops@trykob.com
# PLACES_AUTOCOMPLETE_REGIONS=GB
# CRON_SECRET=
# Optional override for /api/*/status in production (defaults to CRON_SECRET).
# OPS_STATUS_SECRET=

# --- Rate limits (shared across instances via Postgres RateLimitHit; disable for local dev if needed) ---
AUDIT_RATE_LIMIT_MAX_REQUESTS=30
AUDIT_RATE_LIMIT_WINDOW_SEC=3600
# AUDIT_RATE_LIMIT_DISABLED=1
# PLACES_RATE_LIMIT_MAX_REQUESTS=80
# PLACES_RATE_LIMIT_WINDOW_SEC=3600
# PLACES_RATE_LIMIT_DISABLED=1
# Tests only: a throwaway Postgres for lib/security/rate-limit.test.ts (CI db job sets it)
# TEST_DATABASE_URL=postgresql://kob@localhost:55432/kob

# --- PageSpeed Insights (factual mobile performance in audit rubric) ---
# Uses PAGESPEED_API_KEY, or GOOGLE_PAGESPEED_API_KEY, or falls back to GEMINI_API_KEY if enabled for Google APIs.
# PAGESPEED_API_KEY=

# --- Google Maps Platform (audit search + scanning UI) ---
# Cloud Console → enable billing → enable "Places API (New)" + "Maps JavaScript API".
# Server-only key for Places REST (Autocomplete + Place Details). Restrict by IP on servers, or use a
# separate browser-restricted key only if you must call Places from the client (we proxy via /api/places/*).
GOOGLE_PLACES_API_KEY=
# Browser key for embedded map on /audit/[id]/scanning. Restrict by HTTP referrer (localhost, ngrok, prod).
# Also powers Demand Engine → Google Ads · Local (area geocode + nearby venues).
# If unset, scanning falls back to /api/places/static-map using GOOGLE_PLACES_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: tighten Places autocomplete (comma-separated ISO region codes, e.g. US,GB).
# PLACES_AUTOCOMPLETE_REGIONS=US,GB

# --- Sanity CMS (optional) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-02-01

# --- Integrations / misc ---
INTEGRATION_ENC_KEY=
# Rotation only: the old key, so tokens written under it still decrypt. See scripts/rotate-integration-key.ts.
# INTEGRATION_ENC_KEY_PREVIOUS=

# --- Growth toggles (optional) ---
GROWTH_AUTO_AI_RECOMMENDATIONS=
GROWTH_SEED_DEMO=
OUTBOUND_SCAN_CITY=
OUTBOUND_WORKSPACE_RESTAURANT_ID=
# Reddit buying-intent scan (r/restaurant, r/restaurantowners): npm run outbound:reddit-intent
# REDDIT_INTENT_SUBREDDITS=restaurant,restaurantowners
# REDDIT_INTENT_PERSIST=1
# REDDIT_INTENT_ARCHIVE=1
# REDDIT_INTENT_SKIP_DDG=1
# Max outbound emails per send wave (daily hard cap 100 across 10/14/18 UTC).
# OUTBOUND_SEND_BATCH=100
# OUTBOUND_SEND_DELAY_SEC=1

# --- Preview / dev only ---
# Skips auth; always off when CONTEXT=production and in production builds unless ALLOW_UI_PREVIEW_IN_PROD=1.
NEXT_PUBLIC_UI_PREVIEW=
# Never set on trykob.com.
# ALLOW_UI_PREVIEW_IN_PROD=
# 1 = auto-load Growth Agent daily briefing on Today (OpenAI cost on each visit)
# NEXT_PUBLIC_DASHBOARD_AUTO_BRIEFING=1

# --- Inngest (background audit jobs) ---
# Full audit locally (site + Inngest worker): npm run dev:audit
# Requires: DATABASE_URL, INNGEST_DEV=1, GEMINI_API_KEY (benchmark + images), GOOGLE_PLACES_API_KEY (location/competitors)
# Optional: NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (live scanning map; static map fallback uses server key)
# Local: npm run dev:public + npm run inngest:dev (requires INNGEST_DEV=1)
# Production: https://app.inngest.com → sync https://YOUR-SITE.netlify.app/api/inngest
INNGEST_DEV=1
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Apollo (KOB master API key; never commit; ads/secrets/apollo-api-key) ---
# APOLLO_API_KEY=

# --- IndexNow (after Git deploy: npm run resources:indexnow) ---
# Host public/{INDEXNOW_KEY}.txt with the same key. Never commit secrets; the public txt is intentional.
# INDEXNOW_KEY=

# --- Feature flags (lib/flags.ts). Default off; per-restaurant FeatureFlagOverride wins. ---
# Turn on in production only once the approval in docs/setup/EXTERNAL-ACCESS.md is granted.
GBP_LIVE=
WHATSAPP_LIVE=
INSTAGRAM_PUBLISH_LIVE=
GMAIL_ENABLED=
PROACTIVE_ENABLED=
GUEST_INBOX_ENABLED=
CREATIVES_ENABLED=
STREAMING_TALK=
# Integration Hub connectors (Spec 2): a connector feeds capabilities only when its flag is on.
SQUARE_LIVE=

# --- Google Business Profile (same Cloud project as GOOGLE_OAUTH_CLIENT_ID) ---
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_PROJECT_NUMBER=
# GBP_PUBSUB_TOPIC=projects/<project-id>/topics/gbp-notifications
# GBP_PUBSUB_AUDIENCE=https://trykob.com/api/webhooks/gbp-pubsub
# GBP_PUBSUB_PUSH_SA=kob-pubsub-push@<project-id>.iam.gserviceaccount.com

# --- Agent models (lib/agent/model.ts); defaults gemini-2.5-flash / same / gemini-2.5-pro ---
# KOB_AGENT_MODEL=
# KOB_FAST_MODEL=
# KOB_DEEP_MODEL=

# --- Meta: WhatsApp owner channel + Instagram ---
# META_GRAPH_VERSION=
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=
# WHATSAPP_SYSTEM_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WABA_ID=
# WHATSAPP_VERIFY_TOKEN=
# KOB_WHATSAPP_DISPLAY_NUMBER=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=

# --- POS webhooks / partners ---
# SQUARE_WEBHOOK_SIGNATURE_KEY=
# TOAST_CLIENT_ID=
# TOAST_CLIENT_SECRET=

# --- Integration Hub webhooks: POST /api/webhooks/<provider> (lib/hub/webhooks/verifiers) ---
# Signatures are checked against NEXT_PUBLIC_SITE_URL + path; <PROVIDER>_WEBHOOK_URL overrides (e.g. SQUARE_WEBHOOK_URL).
# STRIPE_CONNECT_WEBHOOK_SECRET=
# CLOVER_WEBHOOK_AUTH_CODE=
# XERO_WEBHOOK_KEY=
# QBO_WEBHOOK_VERIFIER=
# PURPLE_WEBHOOK_SALT=
# OPENAI_WEBHOOK_SECRET=
# RETELL_WEBHOOK_SECRET=
# VAPI_SERVER_SECRET=

# --- SMS (optional; not in v1 for the US) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=

# --- Invoice forwarding address (invoices+<slug>@in.trykob.com) ---
# INBOUND_EMAIL_DOMAIN=in.trykob.com
# INBOUND_EMAIL_SIGNING_SECRET=

# --- Local signals ---
# TICKETMASTER_API_KEY=

# --- Creatives (private bucket; signed URLs) ---
# SUPABASE_CREATIVES_BUCKET=kob-creatives

# --- Cost guards ---
# KOB_MONTHLY_COST_CAP_USD=8
# KOB_CREATIVE_DAILY_MAX=6

# --- Observability (optional) ---
# SENTRY_DSN=
# OPS_SLACK_WEBHOOK_URL=

# Action Ledger, dev/e2e only (ignored in production): run approved actions in-process against the memory adapter
# instead of Inngest. KOB_INLINE_STEP_MS is each verify wait. E2E_DATABASE_URL makes Playwright start the dev server
# in UI preview against that (migrated) database for tests/e2e/approval.spec.ts.
# KOB_INLINE_ACTIONS=1
# KOB_INLINE_STEP_MS=600
# E2E_DATABASE_URL=postgresql://kob@localhost:55432/kob_e2e
