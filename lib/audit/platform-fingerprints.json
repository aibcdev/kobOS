    "squarespace": {
      "label": "Squarespace",
      "fingerprints": [
        { "kind": "host", "pattern": "(^|\\.)(squarespace|squarespace-cdn|sqspcdn)\\.com$", "weight": 0.9, "evidence": "Assets from Squarespace CDNs" },
        { "kind": "html", "pattern": "Static\\.SQUARESPACE_CONTEXT", "weight": 0.9, "evidence": "Squarespace page context script" }
