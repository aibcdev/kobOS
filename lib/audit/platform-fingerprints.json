{
  "version": "2026-10-09",
  "source": "docs/research/owner-teardown-2026-10.md",
  "platforms": {
    "owner": {
      "label": "Owner.com",
      "fingerprints": [
        { "kind": "cookie", "pattern": "^owner-(stable-id|brand-id|worker-version)$", "weight": 0.95, "evidence": "Owner session cookie" },
        { "kind": "host", "pattern": "(^|\\.)static-content\\.owner\\.com$", "weight": 0.9, "evidence": "Assets served from static-content.owner.com" },
        { "kind": "host", "pattern": "(^|\\.)owner\\.sh$", "weight": 0.85, "evidence": "Assets served from owner.sh" },
        { "kind": "html", "pattern": "Powered by Owner", "weight": 0.85, "evidence": "Footer reads \"Powered by Owner\"" },
        { "kind": "html", "pattern": "static-content\\.owner\\.com/funnel/", "weight": 0.85, "evidence": "Logo/images hosted on Owner's funnel CDN" },
        { "kind": "html", "pattern": "id=com\\.owner\\.[a-z0-9_]+|bundle-id=\"com\\.owner\\.", "weight": 0.8, "evidence": "Branded app bundle id com.owner.*" },
        { "kind": "html", "pattern": "OwnerAnalytics|owner-analytics-config", "weight": 0.7, "evidence": "Owner analytics component in page" },
        { "kind": "path", "pattern": "^/api/olympus/", "weight": 0.8, "evidence": "Ordering API under /api/olympus/" },
        { "kind": "path", "pattern": "^/universal-log-exposure/?$", "weight": 0.6, "evidence": "Owner experiment logging endpoint" }
      ]
    },
    "toast": {
      "label": "Toast",
