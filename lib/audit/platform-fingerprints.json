        { "kind": "html", "pattern": "powered-by-toast|toast-logo-filled", "weight": 0.85, "evidence": "\"Powered by Toast\" badge" },
        { "kind": "host", "pattern": "(^|\\.)ws-api\\.toasttab\\.com$", "weight": 0.8, "evidence": "Calls Toast web-services API" }
      ]
    },
    "square": {
      "label": "Square Online",
      "fingerprints": [
        { "kind": "generator", "pattern": "^Square Online", "weight": 0.95, "evidence": "Generator meta tag: Square Online" },
