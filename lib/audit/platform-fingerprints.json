      "fingerprints": [
        { "kind": "generator", "pattern": "^(WordPress|Elementor)", "weight": 0.9, "evidence": "Generator meta tag: WordPress/Elementor" },
        { "kind": "html", "pattern": "/wp-content/|/wp-includes/", "weight": 0.85, "evidence": "WordPress asset paths" }
