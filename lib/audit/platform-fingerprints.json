        { "kind": "generator", "pattern": "^Wix\\.com", "weight": 0.95, "evidence": "Generator meta tag: Wix.com" },
        { "kind": "host", "pattern": "(^|\\.)(parastorage|wixstatic)\\.com$", "weight": 0.85, "evidence": "Assets from Wix CDNs" }
